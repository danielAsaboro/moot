    "excerpt": "The adr-tools project will not contain any packaging or distribution scripts and config. Packaging and distribution will be managed by other projects in separate version control repositories."
   }
  },
  {
   "label": "Decision",
   "id": "0007-invoke-adr-config-executable-to-get-configuration",
   "props": {
    "title": "7. Invoke adr-config executable to get configuration",
    "summary": "Replace config.sh with an executable, named adr-config that outputs configuration. Each script in ADR Tools will eval the output of adr-config to configure itself.",
    "decided_on": "2016-12-17",
    "source": "https://github.com/npryce/adr-tools/blob/master/doc/adr/0007-invoke-adr-config-executable-to-get-configuration.md",
    "repo": "npryce/adr-tools",
    "status": "Accepted"
   }
  },
  {
   "label": "Evidence",
   "id": "src:0007-invoke-adr-config-executable-to-get-configuration",
   "props": {
    "kind": "adr",
    "title": "npryce/adr-tools: 7. Invoke adr-config executable to get configuration",
    "date": "2016-12-17",
    "path": "https://github.com/npryce/adr-tools/blob/master/doc/adr/0007-invoke-adr-config-executable-to-get-configuration.md",
    "excerpt": "Replace config.sh with an executable, named adr-config that outputs configuration. Each script in ADR Tools will eval the output of adr-config to configure itself."
   }
  },
