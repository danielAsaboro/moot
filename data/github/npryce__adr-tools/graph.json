   "label": "Decision",
   "id": "0001-record-architecture-decisions",
   "props": {
    "title": "1. Record architecture decisions",
    "summary": "We will use Architecture Decision Records, as described by Michael Nygard in this article: http://thinkrelevance.com/blog/2011/11/15/documenting-architecture-decisions",
    "decided_on": "2016-02-09",
    "source": "https://github.com/npryce/adr-tools/blob/master/doc/adr/0001-record-architecture-decisions.md",
    "repo": "npryce/adr-tools",
    "status": "Accepted"
   }
  },
  {
   "label": "Evidence",
   "id": "src:0001-record-architecture-decisions",
