  {
   "label": "Decision",
   "id": "0002-implement-as-shell-scripts",
   "props": {
    "title": "2. Implement as shell scripts",
    "summary": "The tool is implemented as shell scripts that use standard Unix tools -- grep, sed, awk, etc.",
    "decided_on": "2016-02-12",
    "source": "https://github.com/npryce/adr-tools/blob/master/doc/adr/0002-implement-as-shell-scripts.md",
    "repo": "npryce/adr-tools",
    "status": "Accepted"
   }
  },
  {
   "label": "Evidence",
   "id": "src:0002-implement-as-shell-scripts",
   "props": {
    "kind": "adr",
    "title": "npryce/adr-tools: 2. Implement as shell scripts",
    "date": "2016-02-12",
    "path": "https://github.com/npryce/adr-tools/blob/master/doc/adr/0002-implement-as-shell-scripts.md",
    "excerpt": "The tool is implemented as shell scripts that use standard Unix tools -- grep, sed, awk, etc."
   }
  },
  {
   "label": "Decision",
   "id": "0003-single-command-with-subcommands",
   "props": {
    "title": "3. Single command with subcommands",
    "summary": "The tool defines a single command, called adr. The first argument to adr (the subcommand) specifies the action to perform. Further arguments are interpreted by the subcommand. Running adr without any arguments lists the available subcommands. Subcommands are implemented as scripts in the same direct",
    "decided_on": "2016-02-12",
    "source": "https://github.com/npryce/adr-tools/blob/master/doc/adr/0003-single-command-with-subcommands.md",
    "repo": "npryce/adr-tools",
    "status": "Accepted"
   }
  },
  {
   "label": "Evidence",
   "id": "src:0003-single-command-with-subcommands",
   "props": {
    "kind": "adr",
    "title": "npryce/adr-tools: 3. Single command with subcommands",
    "date": "2016-02-12",
    "path": "https://github.com/npryce/adr-tools/blob/master/doc/adr/0003-single-command-with-subcommands.md",
    "excerpt": "The tool defines a single command, called adr. The first argument to adr (the subcommand) specifies the action to perform. Further arguments are interpreted by the subcommand. Running adr without any arguments lists the available subcommands. Subcommands are implemented as scripts in the same direct"
   }
  },
  {
   "label": "Decision",
   "id": "0004-markdown-format",
   "props": {
