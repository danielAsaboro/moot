# FalkorDB connection (docker compose sets these for you)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
# One named graph per company; the demo tenant is "larkspur"
MOOT_TENANT=larkspur
# The live model (moot/llm.py): picks the answer tool by tool call and narrates audits. Groq when GROQ_API_KEY is set,
# else Anthropic when ANTHROPIC_API_KEY is set, else off (keyword rules and templates). Verdicts never need it.
GROQ_API_KEY=
MOOT_GROQ_MODEL=openai/gpt-oss-120b
# Refuse model calls once this instance has spent this much today (USD); also set a limit in the provider's console
MOOT_LLM_DAILY_USD=1.00
# MOOT_LLM=off
ANTHROPIC_API_KEY=
MOOT_MODEL=claude-sonnet-5-5
# Where the web app listens
PORT=8000
